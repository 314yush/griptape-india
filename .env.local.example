# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: Settings → API → service_role secret (never expose to the browser).
# Used by server routes that need to bypass RLS (e.g. submission notifications), not for phone OTP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone sign-in uses Supabase Auth → Phone provider (e.g. Twilio). Configure SMS in the dashboard;
# no SMS_HTTP_URL is required for login.

# --- Optional: SMS for “application submitted” ping (see /api/notify/application-submitted) ---
# SMS_HTTP_URL=
# SMS_HTTP_AUTH_HEADER=Bearer your-token-here
# SMS_DEV_SKIP=true

# Optional: floating strip on /apply to jump Form · Video · Dashboard (client preview only; remove for prod builds)
# NEXT_PUBLIC_APPLY_STAGE_DEV=1

# Optional: magic-link callback base URL if you use email links elsewhere
NEXT_PUBLIC_SITE_URL=http://localhost:3000
